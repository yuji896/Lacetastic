<?xml version="1.0" encoding="utf-8"?>
<!-- Send to Back icon: two stacked squares, back one highlighted with down-arrow -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Back layer (pink square, being sent back) -->
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#E91E63"
        android:strokeWidth="1.8"
        android:pathData="M4,8 L15,8 L15,19 L4,19 Z" />

    <!-- Down arrow inside back layer -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#E91E63"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M9.5,11 L9.5,15.5 M7.5,13.5 L9.5,15.5 L11.5,13.5" />

    <!-- Front layer (grey square, covering part of back) -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#AAAAAA"
        android:strokeWidth="1.5"
        android:pathData="M9,4 L20,4 L20,15 L9,15 Z" />

</vector>