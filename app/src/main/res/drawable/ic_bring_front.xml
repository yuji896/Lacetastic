<?xml version="1.0" encoding="utf-8"?>
<!-- Bring to Front icon: two stacked squares, top one highlighted with up-arrow -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Back layer (grey square) -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#AAAAAA"
        android:strokeWidth="1.5"
        android:pathData="M4,8 L14,8 L14,18 L4,18 Z" />

    <!-- Front layer (pink square, on top) -->
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#E91E63"
        android:strokeWidth="1.8"
        android:pathData="M9,4 L20,4 L20,15 L9,15 Z" />

    <!-- Up arrow inside front layer -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#E91E63"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M14.5,12 L14.5,7.5 M12.5,9.5 L14.5,7.5 L16.5,9.5" />

</vector>